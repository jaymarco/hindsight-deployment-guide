# Hermes 5 profile Hindsight 集成 env 变量模板
# 部署到: /home/aiagent/.hermes/profiles/<profile>/.env
# ⚠️ 占位符需替换为实际值

# === Hindsight 集成（5 profile 共享） ===
HINDSIGHT_PROVIDER=hindsight
HINDSIGHT_MODE=local_external
HINDSIGHT_URL=http://{{HINDSIGHT_CONTAINER_IP}}:8888
HINDSIGHT_BANK=hermes
HINDSIGHT_PREFETCH_METHOD=recall
HINDSIGHT_PREFETCH_BLOCK=<memory>
HINDSIGHT_MEMORY_ENABLED=true
HINDSIGHT_USER_PROFILE_ENABLED=true

# === LLM 网关 ===
NEWAPI_API_KEY={{NEWAPI_KEY}}
NEWAPI_BASE_URL=http://{{PROD_HOST_IP}}:3000/v1
